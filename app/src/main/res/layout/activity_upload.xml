<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="44dp"
        android:paddingEnd="64dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手机传照片到 U 盘"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="手机连电视同一个 WiFi，用浏览器打开下面地址，选照片上传即可"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="手机访问地址"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/urlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="http://192.168.1.100:8686"
                android:textColor="@color/accent"
                android:textIsSelectable="true"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.1"
                android:text="保存到"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="服务启动中…"
                android:textColor="@color/text_faint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingTop="11dp"
                android:paddingEnd="26dp"
                android:paddingBottom="11dp"
                android:text="停止服务"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingTop="11dp"
                android:paddingEnd="26dp"
                android:paddingBottom="11dp"
                android:text="打开相册"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="说明\n1. 手机与电视必须连同一个路由器 / WiFi；\n2. 支持一次多选照片，上传完成相册会自动刷新；\n3. 目标目录优先选可移动 U 盘，没有 U 盘时退回应用私有目录；\n4. 服务只在当前页面开启，离开页面会自动关闭。"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
